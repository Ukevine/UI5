{
  "name": "bookshop-ui5",
  "version": "0.0.1",
  "description": "An SAP UI5 application.",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap-ux/eslint-plugin-fiori-tools": "^10.0.0",
    "@sap/ux-ui5-tooling": "1",
    "@ui5/cli": "^2.14.20",
    "cds-plugin-ui5": "^0.17.0",
    "eslint": "^10",
    "ui5-task-zipper": "^3.4.x"
  },
  "scripts": {
    "db:deploy": "cds deploy --to sqlite:db.sqlite",
    "start": "cds serve --port 4005",
    "watch": "cds watch",
    "deploy-config": "npx -p @sap/ux-ui5-tooling fiori add deploy-config cf",
    "build:cf": "ui5 build preload --clean-dest --config ui5-deploy.yaml --include-task=generateCachebusterInfo",
    "build": "npm run build:cf"
  },
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.16.1",
    "@cap-js/hana": "^3",
    "@sap/cds": "^10.1.1"
  },
  "cds": {
    "requires": {
      "odata-v2-adapter": {
        "basePath": "/odata/v2"
      },
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "database": "db.sqlite"
          }
        },
        "[production]": {
          "kind": "hana"
        }
      }
    }
  }
}
