<mvc:View
   controllerName="sap.ui.webapp.wt.controller.InvoiceList"
   xmlns="sap.m"
   xmlns:mvc="sap.ui.core.mvc"
   xmlns:core="sap.ui.core"
   xmlns:f="sap.f"
   xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
   xmlns:smartTable="sap.ui.comp.smarttable">
   <f:DynamicPage
      id="invoiceDynamicPage"
      fitContent="true"
      headerExpanded="true"
      preserveHeaderStateOnScroll="true"
      toggleHeaderOnTitleClick="false">
      <f:title>
         <f:DynamicPageTitle>
            <f:heading>
               <Title text="{i18n>invoiceListTitle}" level="H1"/>
            </f:heading>
            <f:actions>
               <Button
                  id="btnNewInvoice"
                  text="{i18n>newPurchaseButton}"
                  icon="sap-icon://add"
                  type="Emphasized"
                  press=".onCreate"/>
               <Button
                  id="btnRefreshInvoices"
                  text="{i18n>refreshButton}"
                  icon="sap-icon://refresh"
                  press=".onRefresh"/>
               <Button
                  id="btnToggleTheme"
                  tooltip="{i18n>toggleThemeButton}"
                  icon="sap-icon://palette"
                  press=".onToggleTheme"/>
               <Button
                  id="btnMessages"
                  icon="sap-icon://message-popup"
                  type="{= ${view>/errorCount} > 0 ? 'Negative' : 'Default' }"
                  text="{= ${view>/messageCount} > 0 ? '' + ${view>/messageCount} : '' }"
                  tooltip="{i18n>messagesButtonTooltip}"
                  visible="{= ${view>/messageCount} > 0 }"
                  press=".onMessagePopoverPress"/>
            </f:actions>
         </f:DynamicPageTitle>
      </f:title>
      
      <f:header>
         <f:DynamicPageHeader pinnable="true">
            <f:content>
               <smartFilterBar:SmartFilterBar
                  id="smartFilterBar"
                  entitySet="Invoices"
                  search=".onSmartFilterSearch"
                  persistencyKey="SmartFilter_Invoices"
                  useToolbar="false">
                  <smartFilterBar:controlConfiguration>
                     <smartFilterBar:ControlConfiguration
                        key="ProductName"
                        visibleInAdvancedArea="true"
                        label="{i18n>columnName}"/>
                     <smartFilterBar:ControlConfiguration
                        key="ShipperName"
                        visibleInAdvancedArea="true"
                        label="{i18n>columnSupplier}"/>
                     <smartFilterBar:ControlConfiguration
                        key="Status"
                        visibleInAdvancedArea="true"
                        label="{i18n>columnStatus}"/>
                  </smartFilterBar:controlConfiguration>
               </smartFilterBar:SmartFilterBar>
            </f:content>
         </f:DynamicPageHeader>
      </f:header>

      <f:content>
         <smartTable:SmartTable
               id="invoiceSmartTable"
               entitySet="Invoices"
               smartFilterId="smartFilterBar"
               tableType="ResponsiveTable"
               useExportToExcel="false"
               useVariantManagement="false"
               useTablePersonalisation="true"
               header="{i18n>invoiceListTitle}"
               showRowCount="true"
               enableAutoBinding="false"
               demandPopin="true"
               beforeRebindTable=".onBeforeRebindTable"
               class="sapUiResponsiveMargin">
               
               <smartTable:customToolbar>
                  <OverflowToolbar design="Transparent">
                     <ToolbarSpacer/>
                     <Button
                        text="{i18n>editSelected}"
                        icon="sap-icon://edit"
                        enabled="{= ${view>/selectedCount} === 1 }"
                        press=".onEditSelected"/>
                     <Button
                        text="{i18n>deleteSelected}"
                        icon="sap-icon://delete"
                        type="Negative"
                        enabled="{= ${view>/selectedCount} > 0 }"
                        press=".onDeleteSelected"/>
                  </OverflowToolbar>
               </smartTable:customToolbar>

               <Table
                  id="invoiceList"
                  mode="MultiSelect"
                  growing="true"
                  growingThreshold="5"
                  growingScrollToLoad="false"
                  growingTriggerText="{i18n>viewMoreInvoices}"
                  items="{invoice>/Invoices}"
                  selectionChange=".onSelectionChange"
                  updateFinished=".onUpdateFinished">
                  
                  <columns>
                     <Column hAlign="End" minScreenWidth="Small" demandPopin="true" width="6em">
                        <Text text="{i18n>columnQuantity}"/>
                     </Column>
                     <Column>
                        <Text text="{i18n>columnName}"/>
                     </Column>
                     <Column minScreenWidth="Small" demandPopin="true">
                        <Text text="{i18n>columnStatus}"/>
                     </Column>
                     <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>columnSupplier}"/>
                     </Column>
                     <Column hAlign="End">
                        <Text text="{i18n>columnPrice}"/>
                     </Column>
                  </columns>

                  <items>
                     <ColumnListItem type="Navigation" press=".onPress">
                        <cells>
                           <ObjectNumber number="{invoice>Quantity}" emphasized="false"/>
                           <ObjectIdentifier title="{invoice>ProductName}"/>
                           <Text text="{
                              path: 'invoice>Status',
                              formatter: '.formatter.statusText'
                           }"/>
                           <Text text="{invoice>ShipperName}"/>
                           <ObjectNumber
                              number="{
                                 parts: [
                                    {path: 'invoice>ExtendedPrice'},
                                    {path: 'view>/currency'}
                                 ],
                                 type: 'sap.ui.model.type.Currency',
                                 formatOptions: {
                                    showMeasure: false
                                 }
                              }"
                              unit="{view>/currency}"
                              state="{= ${invoice>ExtendedPrice} > 50 ? 'Error' : 'Success' }"/>
                        </cells>
                     </ColumnListItem>
                  </items>
               </Table>
            </smartTable:SmartTable>
      </f:content>
   </f:DynamicPage>
</mvc:View>